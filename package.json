{
  "name": "matterjs-particle-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && vite build",
    "preview": "npm run build && vite preview",
    "lint": "cargo fmt --manifest-path physics/Cargo.toml -- --check && cargo clippy --manifest-path physics/Cargo.toml --target wasm32-unknown-unknown -- -D warnings"
  },
  "devDependencies": {
    "binaryen": "^131.0.0",
    "vite": "^8.1.1"
  }
}
